# Explicit synthetic mode; no vendor request is made while true.
HOMERELAY_DEMO_MODE=true
HOMERELAY_DATA_MODE=demo

# Browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-5-mini
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=homerelay_entries
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT_MS=4000
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
DATADOG_API_KEY=
