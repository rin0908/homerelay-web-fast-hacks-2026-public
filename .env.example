# Explicit synthetic app mode; runtime UI makes no vendor request while true.
# The separate opt-in, loopback-only OpenAI verifier is the only exception.
HOMERELAY_DEMO_MODE=true
HOMERELAY_DATA_MODE=demo

# Browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only runtime values — never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-5-mini
# Explicit local live verifier. Keep token and audio path process-only and temporary.
HOMERELAY_OPENAI_VERIFY=false
HOMERELAY_OPENAI_VERIFY_AUDIO=
HOMERELAY_OPENAI_VERIFY_URL=http://127.0.0.1:3110
HOMERELAY_OPENAI_VERIFY_TOKEN=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=homerelay_entries
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT_MS=4000
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_MS=4000
DD_SITE=datadoghq.com
DD_API_KEY=
DATADOG_TIMEOUT_MS=1500

# One-process local verification values. Never commit populated values.
HOMERELAY_LOCAL_SUPABASE_URL=
HOMERELAY_LOCAL_SUPABASE_SECRET_KEY=
HOMERELAY_LOCAL_DEMO_PASSWORD=
HOMERELAY_TEST_SUPABASE_URL=
HOMERELAY_TEST_SUPABASE_PUBLISHABLE_KEY=
HOMERELAY_TEST_SUPABASE_SECRET_KEY=
HOMERELAY_E2E_LIVE=false
HOMERELAY_E2E_PASSWORD=
HOMERELAY_E2E_SUPABASE_SECRET_KEY=

# Explicit hosted verification values. Use synthetic invited accounts only.
HOMERELAY_CLOUD_SUPABASE_VERIFY=false
HOMERELAY_CLOUD_SUPABASE_URL=
HOMERELAY_CLOUD_SUPABASE_PUBLISHABLE_KEY=
HOMERELAY_CLOUD_FAMILY_EMAIL=
HOMERELAY_CLOUD_FAMILY_PASSWORD=
HOMERELAY_CLOUD_HELPER_EMAIL=
HOMERELAY_CLOUD_HELPER_PASSWORD=
HOMERELAY_CLOUD_FOREIGN_FAMILY_EMAIL=
HOMERELAY_CLOUD_FOREIGN_FAMILY_PASSWORD=
